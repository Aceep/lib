# Copy to .env next to compose.yaml.
RCLONE_REMOTE=mega:Library
SYNC_CRON=0 4 * * *
# Daily database copy into ./data/backups, mirrored to <remote>:_sauvegardes. "off" to disable.
BACKUP_CRON=30 4 * * *
BACKUP_KEEP=14
# Optional: lets the summary lookup ask Google Books too (console.cloud.google.com, "Books API", free tier).
GOOGLE_BOOKS_API_KEY=
# Domain name the app is reached on; Caddy gets its HTTPS certificate for it. "localhost" = self-signed.
SITE_ADDRESS=livres.example.org
# First admin account (password: 12 characters minimum). Only read while no account exists.
ADMIN_USER=admin
ADMIN_PASSWORD=
TZ=Europe/Paris
# Folder holding rclone.conf on the host (default: ~/.config/rclone)
# RCLONE_CONFIG_DIR=/home/me/.config/rclone
# Local network only, without Caddy (e.g. a Synology NAS): uncomment these lines.
# COMPOSE_FILE=compose.yaml:compose.lan.yaml
# KYLE_LIB_PORT=3000
# PUID=1000
# PGID=1000
