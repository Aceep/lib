# Copy to .env next to compose.yaml.
RCLONE_REMOTE=mega:Library
SYNC_CRON=0 4 * * *
# Domain name the app is reached on; Caddy gets its HTTPS certificate for it. "localhost" = self-signed.
SITE_ADDRESS=livres.example.org
# First admin account (password: 12 characters minimum). Only read while no account exists.
ADMIN_USER=admin
ADMIN_PASSWORD=
TZ=Europe/Paris
# Folder holding rclone.conf on the host (default: ~/.config/rclone)
# RCLONE_CONFIG_DIR=/home/me/.config/rclone
